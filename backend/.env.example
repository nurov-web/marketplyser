PORT=4000
NODE_ENV=development

# Docker local: docker compose up -d postgres
# Production: Neon pooled URL
DATABASE_URL="postgresql://nurov:nurov@localhost:5432/nurov_marketplace"
# Neon unpooled (direct) URL — барои prisma migrate. Агар як URL доред, ҳамонро ду бор гузоред.
DIRECT_URL="postgresql://nurov:nurov@localhost:5432/nurov_marketplace"

# Ихтиёрӣ. Бе Redis rate-limit дар хотира кор мекунад.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=7d

# URL-и frontend (Vercel). Якчанд origin: бо вергул ҷудо кунед.
FRONTEND_URL=http://localhost:3000

# lax = cookie дар ҳамон домен (Vercel rewrite тавсия мешавад)
# none = агар браузер рост ба Railway равад (HTTPS лозим аст)
COOKIE_SAMESITE=lax

# Расмҳо дар Railway нигоҳ дошта намешаванд — Cloudinary гузоред.
CLOUDINARY_URL=
UPLOAD_DIR=uploads
BITRIX_WEBHOOK_URL=
