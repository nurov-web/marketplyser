generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  SELLER
  ADMIN
  COURIER
}

enum AccountStatus {
  ACTIVE
  WARNED
  RESTRICTED
  SUSPENDED
  BANNED
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
  PICKUP
}

enum PenaltyType {
  WARNING
  TEMPORARY_RESTRICTION
  SUSPENSION
  PERMANENT_BAN
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportTarget {
  USER
  PRODUCT
  REVIEW
  MESSAGE
  SELLER
}

model User {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String
  email         String        @unique
  phone         String        @unique
  passwordHash  String
  avatar        String?
  role          Role          @default(USER)
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller              Seller?
  addresses           Address[]
  cartItems           CartItem[]
  favorites           Favorite[]
  orders              Order[]
  reviews             Review[]
  sentMessages        Message[]          @relation("SentMessages")
  conversationsAsUser Conversation[]     @relation("UserConversations")
  notifications       Notification[]
  reports             Report[]           @relation("Reporter")
  moderationLogs      ModerationLog[]    @relation("TargetUser")
  issuedPenalties     ModerationLog[]    @relation("AdminActor")
  courierOrders       Order[]            @relation("CourierOrders")
  courierApplication  CourierApplication?
}

model CourierApplication {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  city         String
  vehicle      String
  message      String    @default("")
  status       String    @default("PENDING")
  rejectReason String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  @@index([status])
}

model Seller {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName    String
  phone       String
  email       String
  address     String
  description String
  logo        String?
  documents   Json         @default("[]")
  status      SellerStatus @default(PENDING)
  balance     Decimal      @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products      Product[]
  orderItems    OrderItem[]
  conversations Conversation[] @relation("SellerConversations")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  image       String?
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
}

model Product {
  id                String                   @id @default(cuid())
  sellerId          String
  seller            Seller                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category                 @relation(fields: [categoryId], references: [id])
  name              String
  slug              String                   @unique
  description       String
  price             Decimal
  discount          Decimal                  @default(0)
  brand             String?
  stock             Int                      @default(0)
  specs             Json?
  moderationStatus  ProductModerationStatus  @default(PENDING)
  rejectReason      String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  images     ProductImage[]
  cartItems  CartItem[]
  favorites  Favorite[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([moderationStatus])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  city      String
  address   String
  isDefault Boolean @default(false)
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id             String         @id @default(cuid())
  number         Int            @unique
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  fullName       String
  phone          String
  city           String
  address        String
  deliveryMethod DeliveryMethod @default(STANDARD)
  deliveryFee    Decimal        @default(5)
  subtotal       Decimal
  discount       Decimal        @default(0)
  couponCode     String?
  total          Decimal
  status         OrderStatus    @default(PENDING)
  cancelReason   String?
  lat            Float?
  lng            Float?
  courierId      String?
  courier        User?          @relation("CourierOrders", fields: [courierId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([courierId])
  @@index([status])
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  sellerId  String
  seller    Seller      @relation(fields: [sellerId], references: [id])
  name      String
  price     Decimal
  quantity  Int
  status    OrderStatus @default(PENDING)
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal
  createdAt DateTime      @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([userId, productId, orderId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  productId String  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([userId, sellerId, productId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id])
  targetType ReportTarget
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}

model ModerationLog {
  id           String      @id @default(cuid())
  targetUserId String
  targetUser   User        @relation("TargetUser", fields: [targetUserId], references: [id])
  adminId      String
  admin        User        @relation("AdminActor", fields: [adminId], references: [id])
  type         PenaltyType
  reason       String
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
}

model Setting {
  key   String @id
  value String
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String
  value       Decimal
  minSubtotal Decimal   @default(0)
  maxUses     Int       @default(999)
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  uses        CouponUse[]
}

model CouponUse {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  orderId   String?
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model CrmContact {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  company   String?
  bitrixId  String?
  createdAt DateTime  @default(now())
  deals     CrmDeal[]
}

model CrmLead {
  id        String   @id @default(cuid())
  title     String
  name      String
  phone     String
  email     String?
  status    String   @default("NEW")
  source    String   @default("WEB")
  bitrixId  String?
  createdAt DateTime @default(now())
}

model CrmDeal {
  id        String      @id @default(cuid())
  title     String
  amount    Decimal     @default(0)
  stage     String      @default("NEW")
  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id])
  orderId   String?
  bitrixId  String?
  createdAt DateTime    @default(now())
}

enum ServiceProviderStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum ServiceRequestStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

model ServiceCategory {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  icon      String            @default("wrench")
  createdAt DateTime          @default(now())
  providers ServiceProvider[]
}

model ServiceProvider {
  id          String                @id @default(cuid())
  name        String
  phone       String
  city        String
  categoryId  String
  category    ServiceCategory       @relation(fields: [categoryId], references: [id])
  description String
  priceFrom   Decimal               @default(0)
  isFeatured  Boolean               @default(false)
  status      ServiceProviderStatus @default(PENDING)
  sellerId    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  requests    ServiceRequest[]

  @@index([status])
  @@index([city])
  @@index([categoryId])
}

model ServiceRequest {
  id           String               @id @default(cuid())
  providerId   String
  provider     ServiceProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerName String
  phone        String
  message      String               @default("")
  status       ServiceRequestStatus @default(NEW)
  bitrixLeadId String?
  crmLeadId    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([providerId])
}
