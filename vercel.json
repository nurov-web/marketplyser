{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "buildCommand": "npx prisma generate",
      "functions": {
        "src/index.ts": {
          "includeFiles": "{prisma/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**}",
          "maxDuration": 30,
          "memory": 1024
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/uploads/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
